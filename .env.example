# Public frontend configuration (safe to expose in the browser)
NEXT_PUBLIC_PAYLINK_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BOTCHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment only. Keep this in your local .env and never commit it.
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life
BOTCHAIN_TESTNET_VERIFIER_URL=https://scan.bohr.life/api/
