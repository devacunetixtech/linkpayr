# Public frontend configuration (safe to expose in the browser)
NEXT_PUBLIC_LINKPAYR_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_BOTCHAIN_RPC_URL=https://rpc.botchain.ai
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment only. Keep this in your local .env and never commit it.
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
BOTCHAIN_MAINNET_RPC_URL=https://rpc.botchain.ai
BOTCHAIN_MAINNET_VERIFIER_URL=https://scan.botchain.ai/api/
